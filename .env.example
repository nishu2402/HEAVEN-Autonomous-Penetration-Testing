# ╔══════════════════════════════════════════════════════════════════╗
# ║  HEAVEN — Environment Configuration Template                     ║
# ║  Copy to .env and fill in real values before starting.           ║
# ║  NEVER commit .env to version control.                           ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Required: Admin credentials ─────────────────────────────────────
# The username you log into the Web UI with (and what the header badge shows).
# Optional — defaults to "admin" if unset.
HEAVEN_ADMIN_USERNAME=admin
# Set a strong password before first run (min 12 chars recommended).
# When this is set, HEAVEN trusts it and skips the forced-password-change prompt.
# When it's blank, HEAVEN seeds admin/admin and forces a change on first login.
HEAVEN_ADMIN_PASSWORD=change_me_before_use

# ─── Database: PostgreSQL (recommended for persistent engagements) ───
# Leave HEAVEN_DB_URL blank to use SQLite offline mode.
HEAVEN_DB_URL=
HEAVEN_DB_HOST=localhost
HEAVEN_DB_PORT=5432
HEAVEN_DB_NAME=heaven
HEAVEN_DB_USER=heaven
HEAVEN_DB_PASSWORD=change_me_before_use

# ─── API server ───────────────────────────────────────────────────────
HEAVEN_API_HOST=127.0.0.1
HEAVEN_API_PORT=8443
# Comma-separated allowed CORS origins (for the React UI in dev)
HEAVEN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Per-IP request caps (slowapi). Login has its own tighter cap on top of the
# per-account lockout. Format: "<count>/<period>", e.g. 100/minute.
# HEAVEN_RATE_LIMIT_DEFAULT=100/minute
# HEAVEN_RATE_LIMIT_LOGIN=5/minute

# ─── Scan-target policy (SSRF guard) ──────────────────────────────────
# Every scan target is validated at the API before it reaches the scanners.
# Cloud-metadata (169.254.169.254) and other reserved ranges are ALWAYS
# blocked. Loopback/private ranges are allowed by default because scanning
# your own lab is the common case. On a SHARED / hosted deployment, set both
# to 0 so an operator can't pivot the scanner at internal services.
# HEAVEN_ALLOW_LOCALHOST=1
# HEAVEN_ALLOW_PRIVATE=1

# ─── Self-update policy ───────────────────────────────────────────────
# The web app can detect a newer HEAVEN (read-only) and, for admins, apply it
# (git fast-forward + rebuild — i.e. running new code) from the browser. On a
# SHARED / hosted deployment, disable the browser-triggered apply so code
# updates only happen from the shell (`heaven update`). Detection is unaffected.
# HEAVEN_DISABLE_WEB_UPDATE=1
# Auto-check for updates on app open (a network call to the git remote). Off by
# default; the Settings → Updates toggle writes this.
# HEAVEN_UPDATE_AUTO_CHECK=off

# ─── TLS (production) ─────────────────────────────────────────────────
# Point these at your certificate/key for direct TLS (or use a reverse proxy)
# HEAVEN_TLS_CERT=/etc/ssl/certs/heaven.crt
# HEAVEN_TLS_KEY=/etc/ssl/private/heaven.key

# ─── Optional integrations ────────────────────────────────────────────
# Shodan API key for passive recon
# SHODAN_API_KEY=your_shodan_key_here

# NVD API key (increases rate-limit from 5→50 req/30s)
# NVD_API_KEY=your_nvd_key_here

# Webhook URL for alert notifications (Slack, Teams, custom)
# WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── AI layers (LLM) — all optional; HEAVEN runs fully without them ────
# Pick ONE provider. HEAVEN auto-detects whichever key is set (Anthropic →
# OpenAI → Gemini → DeepSeek → configured local), or pin it with
# HEAVEN_LLM_PROVIDER. The LLM is advisory only; the deterministic scanners
# remain the source of truth.
#
# LOCAL (recommended — no API key, no rate limits, private):
#   Run `heaven ai setup` to install Ollama + pull qwen2.5:7b and wire this up.
# HEAVEN_LLM_PROVIDER=ollama
# HEAVEN_OLLAMA_HOST=http://localhost:11434
# HEAVEN_LLM_MODEL=qwen2.5:7b
#   Any OpenAI-compatible server (LM Studio / llama.cpp / vLLM):
# HEAVEN_LLM_PROVIDER=local
# HEAVEN_LLM_BASE_URL=http://localhost:1234/v1
# HEAVEN_LLM_MODEL=your-served-model
# HEAVEN_LLM_API_KEY=          # optional bearer token for a secured local endpoint
#
# CLOUD (rate-limited free tiers; SDKs — Gemini ships in base):
#   Anthropic: pip install -e ".[anthropic]"  https://console.anthropic.com
#   OpenAI:    pip install -e ".[openai]"     https://platform.openai.com/api-keys
# GEMINI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here
# HEAVEN_LLM_MODEL=gemini-flash-latest
#
# DeepSeek (OpenAI-compatible cloud; NO SDK needed, uses the built-in HTTP client):
#   Get a key: https://platform.deepseek.com/api_keys
# HEAVEN_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_key_here
# HEAVEN_LLM_MODEL=deepseek-chat          # or deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # optional override (this is the default)
#
# HYBRID — if the primary provider is unavailable, fall back to this one:
# HEAVEN_LLM_FALLBACK_PROVIDER=gemini

# ─── SIEM forwarding (optional) ───────────────────────────────────────
# HEAVEN_SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector
# HEAVEN_SPLUNK_HEC_TOKEN=your_splunk_hec_token
# HEAVEN_ELASTIC_URL=https://elastic.example.com:9200
# HEAVEN_ELASTIC_API_KEY=your_elastic_api_key

# ─── Ticketing (optional) — heaven tickets ────────────────────────────
# Jira API tokens: https://id.atlassian.com/manage-profile/security/api-tokens
# HEAVEN_JIRA_URL=https://yourorg.atlassian.net
# HEAVEN_JIRA_USER=you@yourorg.com
# HEAVEN_JIRA_TOKEN=your_jira_api_token
# HEAVEN_JIRA_PROJECT=SEC
# Linear: https://linear.app/settings/api
# HEAVEN_LINEAR_TOKEN=your_linear_api_token
# HEAVEN_LINEAR_TEAM_ID=your_linear_team_uuid

# TIP: you don't have to edit this file by hand — set any of these keys in the
# web UI → Settings (paste + Save), or with `heaven config set <KEY>`. All three
# write this same .env, so a key set anywhere works for the CLI, API and web UI.

# ─── Security ─────────────────────────────────────────────────────────
# Set to 1 to disable authentication (CI / local dev only — NEVER in production)
# DISABLE_AUTH=0

# Master password for the encrypted credential vault
# VAULT_MASTER_PASSWORD=change_me

# ─── Debug ────────────────────────────────────────────────────────────
HEAVEN_DEBUG=false
